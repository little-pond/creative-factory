{
  "identity": {
    "brand": "TurboTax",
    "parent": "Intuit",
    "legal_entity": "Intuit Inc.",
    "entity_fact": "TurboTax is Intuit's consumer tax-preparation software for filing federal and state income tax returns.",
    "domain": "turbotax.intuit.com"
  },
  "audience": [
    {"segment": "first-time filers", "note": "anxious; needs reassurance and simplicity"},
    {"segment": "W-2 employees", "note": "straightforward returns; value speed"},
    {"segment": "self-employed", "note": "Schedule C; value maximizing deductions"},
    {"segment": "investors", "note": "stocks/crypto; value accuracy on complex forms"}
  ],
  "voice": {
    "attributes": ["clear", "reassuring", "confident", "jargon-free"],
    "do": ["lead with the benefit", "use plain language", "encourage anxious filers", "be specific"],
    "dont": ["use fear/anxiety pressure", "over-claim", "use tax jargon without explaining it"],
    "banned_tone_words": ["scary", "terrifying", "penalty", "audit risk", "don't get caught"]
  },
  "visual": {
    "palette": {"primary": "#355EBE", "accent": "#FBB034", "neutral_dark": "#1A1A1A", "bg": "#FFFFFF"},
    "fonts": {"display": "Avenir Next", "body": "Avenir Next"},
    "logo_rules": "Min clear space = logo height. Never recolor, stretch, or place on busy imagery.",
    "imagery": {"do": ["real people, warm natural lighting", "approachable, calm"], "dont": ["stock-cliché handshakes", "fear or stress imagery", "fake-looking money shots"]}
  },
  "messaging": {
    "pillars": ["confidence", "maximum refund", "ease"],
    "approved_value_props": ["File with confidence", "Get every dollar you deserve", "Taxes done right"],
    "approved_ctas": ["Start for free", "File with TurboTax", "Get started"]
  },
  "compliance": {
    "banned_patterns": [
      {"id": "specific_refund_amount", "pattern": "(refund of|get back|get)\\s*\\$\\s?\\d", "severity": "blocker", "reason": "Cannot promise a specific refund amount."},
      {"id": "outcome_promise", "pattern": "(guarantee|guaranteed|promise)[^.]{0,30}(save|refund|get back|approv|biggest)", "severity": "blocker", "reason": "Unsubstantiated outcome promise."},
      {"id": "risk_free", "pattern": "risk[\\s-]?free", "severity": "blocker", "reason": "Implies no risk; not permitted."},
      {"id": "fear_pressure", "pattern": "(don't get|avoid the|fear the)\\s+(audit|penalt)", "severity": "blocker", "reason": "Fear-based pressure violates brand + ad policy."},
      {"id": "superlative", "pattern": "\\b(best|#\\s?1|number one|cheapest|fastest)\\b", "severity": "review", "reason": "Superlative/comparative claim needs substantiation + legal review."},
      {"id": "guarantee_word", "pattern": "\\bguarantee", "severity": "review", "reason": "Only approved guarantee names in exact wording (e.g. 'Maximum Refund Guarantee') — verify."}
    ],
    "banned_phrases": [
      {"phrase": "100% free", "severity": "review", "reason": "Free Edition is not for all filers — requires qualifier + eligibility disclaimer."}
    ],
    "required_disclaimers": [
      {"id": "free_edition", "trigger_keywords": ["free", "$0", "no cost"], "marker": "Free Edition", "required_text": "~37% of taxpayers qualify for TurboTax Free Edition (simple Form 1040 returns only).", "reason": "'Free' claims require an eligibility disclaimer."},
      {"id": "max_refund", "trigger_keywords": ["maximum refund", "biggest refund", "max refund", "every dollar"], "marker": "Maximum Refund Guarantee", "required_text": "See Maximum Refund Guarantee terms and conditions.", "reason": "Refund-maximization claims require the guarantee-terms disclaimer."}
    ],
    "review_required_topics": ["audit", "IRS", "guarantee", "refund amount", "comparative pricing"]
  },
  "meta": {"version": "1.0", "owner": "TurboTax brand marketing + Legal", "last_reviewed": "2026-06-22", "note": "Demonstration profile — figures/disclaimer wording are illustrative, not Intuit-approved."}
}
